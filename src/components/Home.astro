---
import { content, site, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const year = new Date().getFullYear();
---
<header class="hero">
  <div class="wrap">
    <nav class="nav" aria-label="Navigation">
      <a class="brand" href={lang === 'fr' ? '/' : '/en/'}>valentin auclerc</a>
      <div class="links">
        <a href="#projets">{c.nav.projects}</a>
        <a href="#savoir-faire">{c.nav.skills}</a>
        <a href="#parcours">{c.nav.path}</a>
        <a href="#contact">{c.nav.contact}</a>
        <a class="lang" href={c.nav.switchHref} hreflang={lang === 'fr' ? 'en' : 'fr'}>{c.nav.switch}</a>
      </div>
    </nav>

    <p class="hello">{c.hero.hello}</p>
    <h1>{c.hero.line1}<br /><span>{c.hero.line2}</span></h1>
    <p class="sub">{c.hero.sub}</p>
    <ul class="chips">{c.hero.chips.map((chip) => <li>{chip}</li>)}</ul>
  </div>
</header>

<main>
  <section id="projets" class="projects wrap" aria-label={c.nav.projects}>
    <article class="card ech">
      <div class="body">
        <span class="kicker warm">{c.projects.echody.kicker}</span>
        <h2>{c.projects.echody.title}</h2>
        <p>{c.projects.echody.text}</p>
        <p class="detail">{c.projects.echody.detail}</p>
        <ul class="tags">{c.projects.echody.stack.map((s) => <li>{s}</li>)}</ul>
        <a class="cta" href={site.echody} rel="noopener">{c.projects.echody.cta} →</a>
      </div>
      <div class="shot">
        <div class="phone">
          <img src="/images/echody.jpg" alt={lang === 'fr' ? "Page d'accueil d'Echody sur mobile" : 'Echody home page on mobile'} width="600" height="1000" loading="eager" />
        </div>
      </div>
    </article>

    <article class="card mes">
      <div class="body">
        <span class="kicker">{c.projects.mes.kicker}</span>
        <h2>{c.projects.mes.title}</h2>
        <p>{c.projects.mes.text}</p>
        <p class="detail">{c.projects.mes.detail}</p>
        <ul class="tags">{c.projects.mes.stack.map((s) => <li>{s}</li>)}</ul>
        <div class="ctas">
          <a class="cta" href={site.monEventsoft.play} rel="noopener">Google Play →</a>
          <a class="cta" href={site.monEventsoft.appStore} rel="noopener">App Store →</a>
        </div>
      </div>
      <div class="shot visual">
        <div class="poster">
          <img src="/images/mon-eventsoft.webp" alt={lang === 'fr' ? "Visuel de l'application Mon EventSoft" : 'Mon EventSoft app visual'} width="720" height="1280" loading="eager" />
        </div>
      </div>
    </article>
  </section>

  <section id="savoir-faire" class="skills wrap">
    <h2 class="section-title">{c.skills.title}</h2>
    <div class="grid">
      {c.skills.items.map((s, i) => (
        <div class="skill">
          <span class="num">0{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="oss wrap">
    <h2 class="section-title">{c.oss.title}</h2>
    <div class="grid">
      {c.oss.items.map((o) => (
        <a class="repo" href={o.href} rel="noopener">
          <span class="tag">{o.tag}</span>
          <h3>{o.t} <span aria-hidden="true">↗</span></h3>
          <p>{o.d}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="parcours" class="path wrap">
    <h2 class="section-title">{c.path.title}</h2>
    <ol>
      {c.path.items.map((p) => (
        <li>
          <span class="y">{p.y}</span>
          <div><h3>{p.t}</h3><p>{p.d}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section id="contact" class="contact wrap">
    <div class="box">
      <h2>{c.contact.title}</h2>
      <p>{c.contact.text}</p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="social">
        <a href={site.linkedin} rel="noopener me">LinkedIn ↗</a>
        <a href={site.github} rel="noopener me">GitHub ↗</a>
      </div>
    </div>
  </section>
</main>

<footer class="footer wrap">
  <span>© {year} {c.footer.rights}</span>
  <a href={c.footer.legalHref}>{c.footer.legal}</a>
</footer>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--blue);
    color: #fff;
    padding: 24px 0 168px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(700px 360px at 88% 0%, rgba(255, 255, 255, .18), transparent 60%),
      radial-gradient(520px 320px at 0% 110%, rgba(255, 180, 120, .38), transparent 60%);
    pointer-events: none;
  }
  .hero .wrap { position: relative; }
  .nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; font-weight: 500; }
  .brand { font-family: var(--display); font-weight: 700; font-size: 18px; text-decoration: none; }
  .links { display: flex; gap: 26px; align-items: center; font-size: 15px; }
  .links a { text-decoration: none; opacity: .9; }
  .links a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .links .lang { border: 1px solid rgba(255, 255, 255, .4); border-radius: 999px; padding: 3px 12px; }
  .hello { margin: 80px 0 0; font-family: var(--display); font-size: 22px; color: #cfdcff; }
  h1 {
    font-family: var(--display);
    font-size: clamp(56px, 10vw, 112px);
    line-height: .95;
    letter-spacing: -.04em;
    font-weight: 800;
    margin: 12px 0 26px;
  }
  h1 span { color: var(--peach); }
  .sub { font-size: 20px; line-height: 1.55; max-width: 600px; color: #e3ebff; margin: 0; }
  .chips { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    font-size: 14px; font-weight: 600;
    background: rgba(255, 255, 255, .14);
    border: 1px solid rgba(255, 255, 255, .26);
    border-radius: 999px; padding: 6px 14px;
  }

  /* ---------- Projets ---------- */
  .projects {
    position: relative;
    margin-top: -112px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .card {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgba(11, 21, 51, .12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card.ech { background: linear-gradient(180deg, #fff 45%, #fff1e2); }
  .card.mes { background: linear-gradient(180deg, #fff 45%, #e6eeff); }
  .body { padding: 32px 32px 8px; }
  .kicker { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--blue); }
  .kicker.warm { color: var(--orange); }
  .card h2 { font-family: var(--display); font-size: 40px; letter-spacing: -.025em; line-height: 1.05; margin: 8px 0 10px; }
  .card p { margin: 0 0 10px; color: var(--muted); font-size: 16px; }
  .card .detail { color: var(--ink); font-weight: 500; }
  .tags { list-style: none; padding: 0; margin: 14px 0 18px; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { font-size: 13px; border: 1px solid #e3e8f2; background: #fff; border-radius: 999px; padding: 3px 10px; color: #334155; }
  .ctas { display: flex; gap: 18px; flex-wrap: wrap; }
  .cta { font-weight: 700; color: var(--blue); text-decoration: none; }
  .ech .cta { color: var(--orange); }
  .cta:hover { text-decoration: underline; text-underline-offset: 4px; }
  .shot { margin-top: auto; padding-top: 24px; display: flex; justify-content: center; height: 330px; overflow: hidden; }
  .phone {
    width: 230px;
    border: 7px solid var(--ink);
    border-bottom: 0;
    border-radius: 34px 34px 0 0;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 30px 60px rgba(11, 21, 51, .25);
    align-self: flex-start;
  }
  .phone img { width: 100%; height: auto; }
  .shot.visual { padding-top: 24px; }
  .shot.visual .poster { width: 290px; height: 100%; border-radius: 26px 26px 0 0; overflow: hidden; box-shadow: 0 30px 60px rgba(11, 21, 51, .22); }
  .shot.visual img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 52%; }

  /* ---------- Sections ---------- */
  .section-title {
    font-family: var(--display);
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -.025em;
    margin: 0 0 28px;
  }
  .skills { margin-top: 112px; }
  .skills .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .skill { border-top: 2px solid var(--ink); padding-top: 16px; }
  .num { font-family: var(--display); color: var(--blue); font-weight: 700; }
  .skill h3 { font-family: var(--display); font-size: 22px; margin: 6px 0 8px; }
  .skill p { margin: 0; color: var(--muted); font-size: 15px; }

  .oss { margin-top: 96px; }
  .oss .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .repo {
    display: block; text-decoration: none;
    background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 22px 24px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .repo:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(11, 21, 51, .08); }
  .repo .tag { font-size: 12px; font-weight: 700; color: var(--blue); background: var(--blue-soft); border-radius: 999px; padding: 3px 10px; }
  .repo h3 { font-family: var(--display); font-size: 21px; margin: 12px 0 6px; }
  .repo p { margin: 0; color: var(--muted); font-size: 15px; }

  .path { margin-top: 96px; }
  .path ol { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .path li { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .path .y { font-family: var(--display); font-weight: 700; color: var(--blue); }
  .path h3 { margin: 0 0 2px; font-size: 19px; }
  .path p { margin: 0; color: var(--muted); font-size: 15px; }

  .contact { margin-top: 104px; }
  .contact .box {
    position: relative; overflow: hidden;
    background: var(--blue); color: #fff;
    border-radius: 36px; padding: 64px 56px;
  }
  .contact .box::after {
    content: ''; position: absolute; width: 420px; height: 420px; border-radius: 50%;
    right: -120px; bottom: -220px; background: radial-gradient(circle, rgba(255, 180, 120, .45), transparent 65%);
  }
  .contact h2 { font-family: var(--display); font-size: clamp(40px, 6vw, 64px); letter-spacing: -.03em; line-height: 1; margin: 0 0 14px; }
  .contact p { color: #e3ebff; font-size: 18px; margin: 0 0 28px; max-width: 520px; }
  .mail {
    position: relative; z-index: 1;
    display: inline-block; font-family: var(--display); font-weight: 700;
    font-size: clamp(22px, 3.4vw, 34px); color: var(--peach); text-decoration: none;
    border-bottom: 3px solid rgba(255, 210, 158, .5);
  }
  .mail:hover { border-bottom-color: var(--peach); }
  .social { position: relative; z-index: 1; display: flex; gap: 24px; margin-top: 30px; font-weight: 600; }
  .social a { text-decoration: none; color: #fff; opacity: .9; }
  .social a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }

  .footer { display: flex; justify-content: space-between; gap: 16px; padding: 36px 0 44px; font-size: 14px; color: var(--muted); }
  .footer a { color: var(--muted); }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .projects { grid-template-columns: 1fr; }
    .skills .grid { grid-template-columns: 1fr 1fr; }
    .oss .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .links a:not(.lang) { display: none; }
    .hero { padding-bottom: 140px; }
    .hello { margin-top: 56px; }
    .sub { font-size: 18px; }
    .body { padding: 26px 22px 6px; }
    .card h2 { font-size: 34px; }
    .skills .grid { grid-template-columns: 1fr; }
    .path li { grid-template-columns: 1fr; gap: 4px; }
    .contact .box { padding: 44px 26px; border-radius: 28px; }
    .footer { flex-direction: column; }
  }
</style>
